# OAuth 2.0 Prototype Configuration
# Copy this file to .env and adjust variables as needed

# Local Server Port (default 8000)
PORT=8000

# Optional: GitHub OAuth App Credentials
# Register at: https://github.com/settings/developers
# Set Authorization callback URL to: http://localhost:8000/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Optional: Google OAuth 2.0 / OpenID Connect Credentials
# Register at: https://console.cloud.google.com/apis/credentials
# Set Authorized redirect URI to: http://localhost:8000/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

